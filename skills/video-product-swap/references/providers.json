{
  "default_provider": "fal",
  "providers": {
    "dashscope": {
      "display_name": "阿里官方（百炼）",
      "default_api_base": "https://dashscope.aliyuncs.com/api/v1",
      "api_base_env": "DASHSCOPE_API_BASE",
      "api_key_env": "DASHSCOPE_API_KEY",
      "default_model": "dashscope-wan3.0-video",
      "submit_path": "services/aigc/video-generation/video-synthesis"
    },
    "fal": {
      "display_name": "fal",
      "default_api_base": "https://queue.fal.run",
      "api_base_env": "FAL_API_BASE",
      "api_key_env": "FAL_KEY",
      "default_model": "wan3.0-video",
      "submit_path": ""
    },
    "kaiyuncode": {
      "display_name": "KaiyunCode",
      "default_api_base": "https://kaiyuncode.com",
      "api_base_env": "KAIYUNCODE_API_BASE",
      "api_key_env": "KAIYUNCODE_API_KEY",
      "default_model": "kaiyuncode-wan3.0-video",
      "submit_path": "v1/videos"
    }
  }
}
